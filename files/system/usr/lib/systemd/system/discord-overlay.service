[Unit]
Description=Overlay mount for Discord (patched upperdir)
After=local-fs.target
Requires=local-fs.target
ConditionPathExists=/usr/share/quantix-os/discord-build-id

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/modprobe overlay
ExecStart=/usr/libexec/quantix-discord-overlay
ExecStop=/usr/bin/umount /opt/discord

[Install]
WantedBy=multi-user.target
